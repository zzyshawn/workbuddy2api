# 【安全】登录态绝不进镜像：桌面端凭据导出物（workbuddy-desktop.info 等）
auth/
auths/
*.info
*.token
*.key
secrets.*

# 本地运行产物
data/
converter-logs/
__pycache__/
*.tmp
*.log
.git/
.gitignore
docs/
scripts/
